# Dependencies
/node_modules

# Next.js
/.next
/out
next-env.d.ts

# Generated by scripts/sync-docs.mjs before every build: the repository's own
# docs as the site's Contributing tree, and the version table the matrix
# renders. Both have a source in the repository; a copy in git would be a
# second one.
/content/contributing
/lib/supported-versions.json

# Fumadocs' compiled content index.
/.source

# Misc
.DS_Store

# Vercel. `vercel link` writes both: .vercel holds the project it is linked to
# and .env* the OIDC token it downloads with it. Added by the CLI itself, and
# kept, because the first is machine-local and the second is a credential.
.vercel
.env*
