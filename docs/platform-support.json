  "whys": {
    "win-style": {
      "text": "Direct2D draws it, nothing reads the prop",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-windows.md"
    },
    "win-outline": {
      "text": "DrawRoundedRectangle and a stroke style",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-windows.md"
    },
    "win-shadow": {
      "text": "CLSID_D2D1Shadow",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-windows.md"
    },
    "win-filter": {
      "text": "CLSID_D2D1ColorMatrix and friends",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-windows.md"
    },
    "win-gradient": {
      "text": "the gradient brushes",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-windows.md"
    },
    "win-blend": {
      "text": "CLSID_D2D1Blend",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-windows.md"
    },
    "win-cursor": {
      "text": "WM_SETCURSOR needs a hit test",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-windows.md"
    },
    "win-text": {
      "text": "DirectWrite is given it",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-windows.md"
    },
    "win-a11y": {
      "text": "the UIA provider",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-windows.md"
    },
    "mac-dropshadow": {
      "text": "macOS draws the first of a list",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-macos.md"
    },
    "gtk-pluslighter": {
      "text": "GSK has no plus-lighter",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/correctness.md"
    },
    "cannot-arrive": {
      "text": "only the iOS view config declares it, and the two desktops would draw different corners",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/correctness.md"
    },
    "no-group": {
      "text": "no public way to composite a subtree as a group",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/correctness.md"
    },
    "hints": {
      "text": "performance hints, and one cannot arrive",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/correctness.md"
    },
    "reactcommon": {
      "text": "ReactCommon consumes it, and a scenario proves it here",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/correctness.md"
    },
    "text-ignored": {
      "text": "on the ignored list, with the call named",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/text.md"
    },
    "text-shadow-one": {
      "text": "one shadow per paragraph, not per fragment",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/text.md"
    },
    "text-ios": {
      "text": "iOS's own, with no desktop equivalent",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/text.md"
    },
    "measurelines": {
      "text": "the cxx TextLayoutManager has no measureLines",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/upstream.md"
    },
    "a11y-ignored": {
      "text": "on the ignored list",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/accessibility.md"
    },
    "a11y-ios": {
      "text": "iOS's own, with no desktop equivalent",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/accessibility.md"
    },
    "win-textscale": {
      "text": "the scale is there, as UISettings.TextScaleFactor, and needs WinRT",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-windows.md"
    },
    "text-decoration-style": {
      "text": "each engine draws the styles it has: Pango no dots or dashes, Core Text no wavy, DirectWrite none of them without a custom renderer",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/text.md"
    },
    "win-textvariant": {
      "text": "DWRITE_FONT_FEATURE_TAG takes the same tags core resolves",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-windows.md"
    },
    "gtk-accessible-id": {
      "text": "GTK publishes an accessible id from 4.22; CI's 4.14 carries it and cannot publish it",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/accessibility.md"
    },
    "a11y-language": {
      "text": "GTK has no accessible language property; macOS 26 for a view-wide one, UIA wants an LCID",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/accessibility.md"
    },
    "win-reading-direction": {
      "text": "IDWriteTextLayout::SetReadingDirection, and a natural alignment that follows it",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-windows.md"
    },
    "win-reading-order": {
      "text": "UIA has no reading-order property: the tree order is the order",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/accessibility.md"
    },
    "win-decoration-paint": {
      "text": "the line is drawn, its colour and pattern need an IDWriteTextRenderer",
      "link": "https://github.com/vincentvella/basalt/blob/main/docs/backlog/platform-windows.md"
    }
  },
