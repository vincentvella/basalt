{
  // Checked, not compiled -- there is no `dist` here and there should not be.
  //
  // Every JavaScript file in this package is in `react-native.config.js`'s load
  // path, and React Native's CLI reads that from `node_modules/<package>/` as
  // plain CommonJS. Putting it behind a build would mean a tool this project
  // does not control loading output that might not exist yet, to type a hundred
  // lines that are mostly a data literal.
  //
  // So: `noEmit`, and the files opt in with `// @ts-check`.
  "extends": "../basalt-core/tsconfig.paths.json",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "lib": ["es2022"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules"]
}
