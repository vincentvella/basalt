{
  // Generated by scripts/build_ts.sh, which fills in where this machine put
  // the React Native checkout. See there for why it is not committed.
  "extends": "./tsconfig.paths.json",

  // The build for basalt-core. See docs/DECISIONS.md, "TypeScript, with
  // a compile step", for why this exists at all.
  //
  // `allowJs` with `checkJs` off is the migration, not the destination. Every
  // file here is still JavaScript; tsc copies what it cannot yet check into
  // `dist/` so that `main`, `exports` and OVERRIDE_DIR can all point at built
  // output from the first commit rather than the last. Files become TypeScript
  // one at a time underneath a build that already works.
  //
  // `strict` therefore applies to the .ts files as they arrive, which is the
  // whole point of turning it on now: there are five thousand lines here and
  // retrofitting strictness later is the expensive version of this.
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": false,

    // CommonJS, and not negotiable: react-native.config.js and metro-config.js
    // are required out of node_modules by React Native's CLI and by an app's
    // own metro.config.js, neither of which this project controls.
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    // React Native's automatic runtime. The components here use
    // React.createElement rather than JSX today, but a .tsx module cannot be
    // resolved at all without this set.
    "jsx": "react-jsx",
    "lib": ["es2022"],

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "rootDir": ".",
    "outDir": "dist",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true,

    // A .js in this tree is a source file, not an artifact.
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "cli/**/*", "metro-config.js", "react-native.config.js"],

  "exclude": ["dist", "node_modules"]
}
