{
  // The paths file is generated into the core package by scripts/build_ts.sh,
  // and says where this machine put its React Native checkout. Shared rather
  // than generated twice: there is one checkout and both packages type-check
  // against it.
  "extends": "../basalt-core/tsconfig.paths.json",

  // Settings mirror basalt-core's, deliberately: two packages in one
  // repository compiling under different rules is a difference nobody chose.
  "compilerOptions": {
    "strict": true,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "lib": ["es2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["index.ts"]
}
