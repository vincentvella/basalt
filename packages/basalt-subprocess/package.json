    "spawn",
    "exec",
    "shell",
    "desktop",
    "basalt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincentvella/basalt.git",
    "directory": "packages/basalt-subprocess"
  },
  "homepage": "https://basaltjs.dev",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "basalt": {
