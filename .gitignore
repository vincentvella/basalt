build/
# Testing a second React Native means a second build tree; scripts/bundle.sh and
# scripts/integration_test.py both take --build-dir for exactly that.
build-*/

# Fetched third-party sources, pinned to the versions React Native builds
# against. See README.md for the curl/tar commands that populate these.
third_party/folly/
third_party/fast_float/
third_party/hermes/
third_party/hermes-build/
third_party/nlohmann_json/
third_party/node/
third_party/codegen/

# CI clones React Native inside the workspace, because actions/cache will not
# save a path that escapes it.
react-native-src/

# Metro's Babel register cache. The demo app installs nothing of its own; see
# js/metro.config.js for how react and react-native are resolved instead.
js/node_modules/

# The example app links these in; examples/demo/setup.sh recreates them.
examples/*/node_modules/

# `run-linux` writes the detached packager log here.
.basalt/

# Python leaves these beside any script it imports; the integration suite is
# imported directly when running a single scenario.
__pycache__/
*.pyc

# Built by scripts/build_ts.sh. `main` points into it; it is not source.
packages/*/dist/
*.tsbuildinfo
# Generated by scripts/build_ts.sh: absolute paths to this machine's checkout.
packages/*/tsconfig.paths.json

# The CI jobs that set CCACHE_DIR inside the workspace (macOS, Windows).
/ccache/

# Docusaurus build output and caches.
website/build/
website/.docusaurus/
