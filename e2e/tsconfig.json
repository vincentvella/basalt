{
  // Checked, never emitted. Metro reads these files directly and compiles them
  // with React Native's Babel preset, which strips types and asks no questions
  // about them. Nothing here produces a dist/, so `noEmit` is the whole point:
  // this exists to answer "does the app still agree with the API it calls",
  // which until now nothing did.
  "extends": "../packages/basalt-core/tsconfig.paths.json",

  "compilerOptions": {
    "strict": true,
    // `bundler`, because the bundler is Metro and Node's rules are not the
    // ones it follows. A third-party module that ships ESM -- async-storage
    // 3.x is the first one here -- is a type error under node16 ("cannot be
    // imported with require") and bundles perfectly well, because Babel
    // strips the import and Metro resolves it. The check should answer the
    // question the app actually faces.
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022"],
    "jsx": "react-jsx",
    "noEmit": true,
    "esModuleInterop": true,
    // One app imports one JSON file: e2e/turbomodules.tsx reads
    // docs/platform-modules.json and asks the running host for every module in
    // it, rather than keeping a second copy of seventy names. Metro bundles a
    // JSON import without being asked; the type checker needs telling.
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },

  // The two config files stay JavaScript: Metro and Babel load them as plain
  // CommonJS from a path convention, before anything could have compiled them.
  "include": ["*.tsx", "*.ts", "types.d.ts"]
}
